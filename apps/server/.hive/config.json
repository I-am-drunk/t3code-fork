{
  "agents": {
    "vale": {
      "model": "zai/glm-5-turbo"
    },
    "rafe": {
      "model": "zai/glm-4-6",
      "max_tool_calls": 300
    },
    "knox": {
      "model": "zai/glm-4-6",
      "max_tool_calls": 400
